{
  "framework": "vite",
  "installCommand": "npm install --include=dev --workspaces --include-workspace-root",
  "buildCommand": "npm run build --workspace @rpg-builder/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
